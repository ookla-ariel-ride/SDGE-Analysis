# .env.example — TEMPLATE for the repo-root .env file consumed by
# analysis/llm_providers.py (issue #39: generate the report with your own
# paid LLM key, no agentic coding tool required).
#
# Copy this file to .env (already gitignored — .env and .env.* never commit,
# this template is the one deliberate exception) and fill in ONLY the key(s)
# for the provider(s) you actually plan to call. Nothing reads this file
# except analysis/llm_providers.py's load_env(); no key is ever accepted as a
# command-line argument (shell history, `ps` would both leak it).
#
# KEY=VALUE per line, one per line, '#' starts a whole-line comment, blank
# lines are skipped. No quoting and no inline (end-of-line) comments — the
# parser is deliberately ~10 lines, so put the value and nothing else after
# the '='.

# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# platform.openai.com -> API keys
OPENAI_API_KEY=

# aistudio.google.com -> Get API key (this variable is GEMINI_API_KEY, not
# GOOGLE_API_KEY)
GEMINI_API_KEY=
